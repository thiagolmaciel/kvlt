ANTHROPIC_API_KEY=

# Personal access token with contents:write on thiagolmaciel/kvlt.
# Used by /api/trend-signals to commit incorporated news signals to the repo.
GITHUB_TOKEN=
# Optional overrides, default to thiagolmaciel/kvlt @ master.
GITHUB_REPO=
GITHUB_BRANCH=

# Per-founder login password. Whichever matches determines the session identity.
THIAGO_PASSWORD=
RODRIGO_PASSWORD=
# Random secret signing the session cookie (JWT HS256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Supabase project (used by /api/flags for the "faltas" panel: roadmap
# checklist, warehouse pending items, unseen signals, undecided ideas).
# Service role key only — never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
